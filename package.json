{
  "name": "dsh-pajama-whale",
  "version": "0.3.2",
  "description": "A tiny person in a blue-whale onesie you can drag around the DSH window; he sticks to the window edges, pressed flat, and blinks now and then.",
  "type": "module",
  "license": "MIT",
  "icon": "./assets/icon.png",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "author": "lubenkov (https://github.com/lubenkov)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lubenkov/dsh-pajama-whale.git"
  },
  "homepage": "https://github.com/lubenkov/dsh-pajama-whale",
  "bugs": {
    "url": "https://github.com/lubenkov/dsh-pajama-whale/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "pet",
    "whale",
    "desktop-companion"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon.png",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "assets/icon.png",
    "assets/build/*.webp",
    "locale/*.json",
    "tools/build-client.mjs",
    "README.md",
    "README.zh.md",
    "COMPATIBILITY.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
